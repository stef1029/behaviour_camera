{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "SPINNAKER_ROOT": "C:/Program Files/Teledyne/Spinnaker"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja x64 Release",
      "description": "Fast incremental builds. The default for day-to-day work.",
      "inherits": "base",
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja x64 Debug",
      "description": "Debug CRT, links the debug Spinnaker library.",
      "inherits": "base",
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64)",
      "description": "Generates a .sln for machines with VS 2022.",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 (x64)",
      "description": "Generates a .sln. Use when you want the Visual Studio debugger or profiler.",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    }
  ],
  "buildPresets": [
    { "name": "ninja-release", "configurePreset": "ninja-release", "displayName": "Build (Release)" },
    { "name": "ninja-debug", "configurePreset": "ninja-debug", "displayName": "Build (Debug)" },
    { "name": "vs2022-release", "configurePreset": "vs2022", "configuration": "Release", "displayName": "Build (VS 2022 Release)" },
    { "name": "vs2022-debug", "configurePreset": "vs2022", "configuration": "Debug", "displayName": "Build (VS 2022 Debug)" },
    { "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release", "displayName": "Build (VS 2026 Release)" },
    { "name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug", "displayName": "Build (VS 2026 Debug)" }
  ]
}
